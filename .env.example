# Runtime mode: production refuses mock embeddings and template generation.
IP_SAKTI_ENV=production
IP_SAKTI_TEST_MODE=false
IP_SAKTI_CORS_ORIGINS=http://localhost:8000
IP_SAKTI_CORPUS_ROOT=./data/corpus
IP_SAKTI_LLM_PROVIDER=nvidia
IP_SAKTI_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
IP_SAKTI_LLM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_KEY=

# Optional local persistence location.
IP_SAKTI_INDEX_PATH=./data/runtime/ip_sakti_index.sqlite3
